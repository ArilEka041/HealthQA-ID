# Google (Gemini / Gemma via Google AI Studio atau Vertex)
GOOGLE_API_KEY=your_google_key
# atau
GEMINI_API_KEY=your_gemini_key

# Rate limiter
HEALTHQA_RPM_LIMIT=2

# Default Model
HEALTHQA_MODEL=gemini-3.5-flash
HEALTHQA_JUDGE_MODEL=gemma4-e4b-local

# Thinkinking level (Global override)
HEALTHQA_THINKING_LEVEL=none

# Google AI model thinking levels
THINKING_LEVEL_GEMINI_25_FLASH=high       
THINKING_LEVEL_GEMINI_25_FLASH_LITE=none  
THINKING_LEVEL_GEMINI_31_FLASH_LITE=none   
THINKING_LEVEL_GEMINI_35_FLASH=high

# Base Ollama URL
OLLAMA_LOCAL_BASE_URL=http://localhost:11434/api
OLLAMA_API_BASE_URL=https://ollama.com/api